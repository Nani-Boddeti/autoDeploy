#!/usr/bin/env bash
# ExecStartPost helper: succeed only once the helper's socket exists as a socket
# owned root:<agent gid> mode 0620, the exact metadata the agent-side clients
# verify (docs/checkout-isolation.md "Readiness"). Usage: checkout-wait-socket PATH AGENT_GID
set -euo pipefail
path="${1:?socket path}"
gid="${2:?agent gid}"
for _ in $(seq 1 100); do
  if [[ -S "$path" && "$(stat -c '%u:%g:%a' "$path")" == "0:$gid:620" ]]; then exit 0; fi
  sleep 0.1
done
echo "checkout-wait-socket: $path not ready with root:$gid 0620" >&2
exit 1
