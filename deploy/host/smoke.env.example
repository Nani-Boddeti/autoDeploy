# Environment for the privileged checkout smoke test (step 18d):
#   make test-checkout-integration  /  internal/gitcheckout TestPrivilegedHelperIsolation
# Values match what deploy/host/install-checkout.sh creates with its defaults
# (agent uid/gid 800, checkout uid/gid 801). If you overrode CHECKOUT_AGENT_ID /
# CHECKOUT_USER_ID, or want the live values, take them from /etc/autodeploy/checkout.env.
# No secrets: every value is an ID, a path or a bound.
#
# HOW TO RUN. The test refuses to run as root and requires euid == AGENT_UID and
# egid == AGENT_GID, so it must run AS autodeploy-agent, after both helper units
# are active (preflight-checkout.sh passes). Ubuntu home directories are 0750 and
# autodeploy-agent has no home, so do not run `make` as that user. Instead build
# the test binary as yourself, then run only the binary as the agent:
#
#   go test -c -tags=checkout_integration -o ./gitcheckout.test ./internal/gitcheckout
#   T="$(sudo mktemp -d)"                      # root-owned 0700; not a predictable /tmp name
#   sudo install -m 0755 -o root -g root ./gitcheckout.test "$T/gitcheckout.test"
#   sudo chmod 0711 "$T"                       # the agent must be able to traverse it
#   sudo -u autodeploy-agent env $(grep -v '^#' deploy/host/smoke.env | xargs) \
#     "$T/gitcheckout.test" -test.run TestPrivilegedHelperIsolation -test.count=1 -test.v
#   sudo rm -rf "$T"
#
# (copy this file to smoke.env first; the real Makefile target `make
# test-checkout-integration` runs the same package with these variables exported
# and a user that can read the repo, if you prefer it.)
AUTODEPLOY_CHECKOUT_INTEGRATION=1
AUTODEPLOY_CHECKOUT_QUOTA_SOCKET=/run/autodeploy-checkout-quota/quota.sock
AUTODEPLOY_CHECKOUT_SPAWN_SOCKET=/var/lib/autodeploy/checkout-exec/spawn.sock
# <unit cgroup>/leaves, created by checkout-exec-launch (Slice=system.slice).
AUTODEPLOY_CHECKOUT_CGROUP_ROOT=/sys/fs/cgroup/system.slice/autodeploy-checkout-exec.service/leaves
AUTODEPLOY_CHECKOUT_AGENT_UID=800
AUTODEPLOY_CHECKOUT_AGENT_GID=800
AUTODEPLOY_CHECKOUT_UID=801
AUTODEPLOY_CHECKOUT_GID=801
# Must not exceed the helper limits: 2147483648 bytes / 400000 inodes by default.
AUTODEPLOY_CHECKOUT_QUOTA_BYTES=268435456
AUTODEPLOY_CHECKOUT_QUOTA_INODES=100000
# Must not exceed checkout-exec --max-duration (2m) / --max-output (1048576).
AUTODEPLOY_CHECKOUT_TIMEOUT_SECONDS=60
AUTODEPLOY_CHECKOUT_MAX_OUTPUT=65536
